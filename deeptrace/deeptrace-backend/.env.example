# --- LLM Provider (existing) ---
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Disruption Sensing: News/Event Data Providers ---
# Tried in this order; each falls back to the next on failure.

# 1. PRIMARY — GDELT Cloud (structured events, country-code filtering)
# Get a key: https://gdeltcloud.com/api-keys
GDELT_CLOUD_API_KEY=

# 2. SECONDARY FALLBACK — NewsAPI.org (free tier: 100 requests/day)
# Get a key: https://newsapi.org/register
NEWSAPI_KEY=

# 3. TERTIARY FALLBACK — GNews.io (free tier available)
# Get a key: https://gnews.io/register
GNEWS_API_KEY=

# 4. LAST RESORT (optional) — legacy free GDELT DOC 2.0 API, no key required.
# NOTE: confirmed to have intermittent infrastructure outages during our own
# testing (also acknowledged publicly by the GDELT Project's maintainers).
# Kept only as an additional free fallback, not relied on as primary.
ENABLE_LEGACY_GDELT_DOC_API=true

# --- Timeouts ---
# Max seconds to wait on any single provider before moving to the next
NEWS_PROVIDER_TIMEOUT_SECONDS=6
# Hard ceiling across the entire fallback chain, regardless of individual timeouts
NEWS_SENSE_TOTAL_BUDGET_SECONDS=20

# --- Existing settings (unchanged) ---
MONITOR_POLL_INTERVAL_SECONDS=20
DEMO_TIME_SCALE=1m=6h
